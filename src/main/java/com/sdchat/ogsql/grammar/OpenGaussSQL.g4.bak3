// OpenGauss SQL Grammar
// Version: 1.0.0
// Based on PostgreSQL ANTLR4 grammar from antlr/grammars-v4 repository
// Extended with OpenGauss-specific features: Hints, Partitioning, Foreign Tables

grammar OpenGaussSQL;

@header {
package com.sdchat.ogsql.grammar;
}

// ==================== Parser Rules ====================

// Root rule for parsing SQL
root
    : stmtblock EOF
    ;

// Block of statements
stmtblock
    : stmtmulti
    ;

// Multiple statements
stmtmulti
    : stmt? (SEMI stmt?)*
    ;

// Statement types (MVP subset - will be expanded)
stmt
    : selectstmt
    | insertstmt
    | updatestmt
    | deletestmt
    | createstmt
    | createprocedurestmt
    | alterprocedurestmt
    | alterstmt
    | dropstmt
    | callstmt
    | setstmt
    | createschemastmt
    | explainstmt
    | showstmt
    | beginstmt
    | commitstmt
    | rollbackstmt
    | analyzestmt
    ;

// ==================== WITH Clause (Common Table Expressions) ====================

withClause
    : WITH RECURSIVE? commonTableExpr LPAREN,' commonTableExpr)*
    ;

commonTableExpr
    : IDENTIFIER 'LPAREN IDENTIFIER LPAREN,' IDENTIFIER)* RPAREN' AS 'LPAREN selectstmt RPAREN'
    | IDENTIFIER AS 'LPAREN selectstmt RPAREN'
    ;

// ==================== SELECT Statement ====================

selectstmt
    : withClause? SELECT hintComment? optdistinct selectlist fromclause whereclause groupbyclause havingclause orderbyclause limitclause
    ;

hintComment
    : HINT_COMMENT
    |
    ;

optdistinct
    : DISTINCT
    | ALL
    |
    ;

selectlist
    : expr LPAREN,' expr)*
    | MULT_OP
    ;

// ==================== FROM Clause ====================

fromclause
    : FROM fromExpression
    |
    ;

fromExpression
    : tableExpression (joinExpression)*
    | tableExpression LPAREN,' tableExpression)*
    |
    ;

tableExpression
    : tableReference optalias
    ;

tableReference
    : IDENTIFIER
    | 'LPAREN selectstmt RPAREN' 
    ;

joinExpression
    : joinType tableExpression joinCondition?
    ;

joinType
    : JOIN
    | INNER JOIN
    | LEFT JOIN
    | RIGHT JOIN
    | FULL JOIN
    | FULL OUTER JOIN
    | LEFT OUTER JOIN
    | RIGHT OUTER JOIN
    | CROSS JOIN
    ;

joinCondition
    : ON aexpr
    | USING 'LPAREN columnlist RPAREN'
    ;

optalias
    : AS IDENTIFIER
    | IDENTIFIER
    |
    ;

// ==================== WHERE Clause ====================

whereclause
    : WHERE aexpr
    |
    ;

// ==================== GROUP BY Clause ====================

groupbyclause
    : GROUP BY expr LPAREN,' expr)*
    |
    ;

// ==================== HAVING Clause ====================

havingclause
    : HAVING aexpr
    |
    ;

// ==================== ORDER BY Clause ====================

orderbyclause
    : ORDER BY sortby LPAREN,' sortby)*
    |
    ;

sortby
    : expr optascdescoptnullsorder
    ;

optascdescoptnullsorder
    : ASC optnullsorder
    | DESC optnullsorder
    |
    ;

optnullsorder
    : NULLS FIRST
    | NULLS LAST
    |
    ;

// ==================== LIMIT Clause ====================

limitclause
    : LIMIT selectlimitvalue offsetclause
    | offsetclause
    |
    ;

selectlimitvalue
    : aexpr
    | ALL
    ;

selectoffsetvalue
    : OFFSET selectoffsetvalue2
    ;

selectoffsetvalue2
    : aexpr
    ;

offsetclause
    : OFFSET selectoffsetvalue2
    |
    ;

// ==================== INSERT Statement ====================

insertstmt
    : INSERT INTO IDENTIFIER optcolumnList insertrest upsertClause?
    ;

optcolumnList
    : 'LPAREN columnlist RPAREN'
    |
    ;

columnlist
    : IDENTIFIER LPAREN,' IDENTIFIER)*
    ;

insertrest
    : VALUES inserttargetlist LPAREN,' inserttargetlist)*
    | selectstmt
    ;

inserttargetlist
    : 'LPAREN inserttargetel LPAREN,' inserttargetel)* RPAREN'
    ;

inserttargetel
    : aexpr
    | DEFAULT
    ;

// ==================== UPSERT Clause (ON DUPLICATE KEY UPDATE) ====================

upsertClause
    : ON DUPLICATE KEY UPDATE setClause whereclause?
    | ON DUPLICATE KEY UPDATE NOTHING
    ;

setClause
    : settarget LPAREN,' settarget)*
    ;

// ==================== UPDATE Statement ====================

updatestmt
    : UPDATE IDENTIFIER optalias SET setclist fromclause whereclause
    ;

setclist
    : settarget LPAREN,' settarget)*
    ;

settarget
    : IDENTIFIER '=' aexpr
    ;

// ==================== DELETE Statement ====================

deletestmt
    : DELETE (FROM)? IDENTIFIER optalias whereclause
    ;

// ==================== CREATE Statement ====================

createstmt
    : CREATE TABLE IDENTIFIER 'LPAREN opttableelementlist RPAREN' optPartitionBy
    | createForeignTableStmt
    ;

// ==================== CREATE PROCEDURE Statement ====================

createprocedurestmt
    : CREATE (OR REPLACE)? PROCEDURE IDENTIFIER 'LPAREN optparameterlist RPAREN' 
      (LANGUAGE IDENTIFIER)?
      (SECURITY DEFINER)?
      (AS | IS) procedureBody
      (LANGUAGE IDENTIFIER)?
      (SEMI)?
    ;

procedureBody
    : dolString
    | BEGIN statementList END
    ;

statementList
    : stmt (SEMI stmt)* SEMI?
    ;

alterprocedurestmt
    : ALTER PROCEDURE IDENTIFIER (
      RENAME TO IDENTIFIER
      | OWNER TO IDENTIFIER
      | SET SCHEMA IDENTIFIER
      | SECURITY INVOKER
      )
      (SEMI)?
    ;

// ==================== CALL Statement ====================

callstmt
    : CALL IDENTIFIER callArguments (SEMI)?
    ;

callArguments
    : 'LPAREN (callArg LPAREN,' callArg)*)? RPAREN'
    ;

callArg
    : aexpr
    | IDENTIFIER ARROW aexpr
    ;

optparameterlist
    : parameterlist
    |
    ;

parameterlist
    : parameterdef LPAREN,' parameterdef)*
    ;

parameterdef
    : IDENTIFIER (IN | OUT | INOUT)? typename (DEFAULT aexpr)?
    ;

dolString
    : '$$' ( ~'$' | '$' ~'$' )* '$$'
    ;

opttableelementlist
    : tableelementlist
    |
    ;

tableelementlist
    : tableelement LPAREN,' tableelement)*
    ;

tableelement
    : columnDef
    | tableconstraint
    ;

columnDef
    : IDENTIFIER typename colquallist
    ;

typename
    : IDENTIFIER
    | IDENTIFIER 'LPAREN ICONST RPAREN'
    | IDENTIFIER 'LPAREN ICONST ',' ICONST RPAREN'
    ;

colquallist
    : colconstraint LPAREN,' colconstraint)*
    |
    ;

colconstraint
    : NOT NULL_P
    | NULL_P
    | DEFAULT aexpr
    | UNIQUE
    | PRIMARY KEY
    ;

tableconstraint
    : CONSTRAINT IDENTIFIER constraintElem
    | constraintElem
    ;

constraintElem
    : UNIQUE 'LPAREN columnlist RPAREN'
    | PRIMARY KEY 'LPAREN columnlist RPAREN'
    | CHECK 'LPAREN aexpr RPAREN'
    ;

// ==================== Partitioning (OpenGauss) ====================

optPartitionBy
    : PARTITION BY partitionStrategy 'LPAREN columnlist RPAREN' optPartitionByClause
    |
    ;

partitionStrategy
    : RANGE
    | LIST
    | HASH
    ;

optPartitionByClause
    : PARTITIONS ICONST
    | 'LPAREN optPartitionDefElementList RPAREN'
    | SUBPARTITION BY partitionStrategy 'LPAREN columnlist RPAREN' optSubpartitionByClause
    |
    ;

optPartitionDefElementList
    : partitionDefElement LPAREN,' partitionDefElement)?
    |
    ;

partitionDefElement
    : PARTITION IDENTIFIER VALUES partitionBoundSpec
    ;

optSubpartitionByClause
    : SUBPARTITIONS ICONST
    | 'LPAREN optSubpartitionDefElementList RPAREN'
    |
    ;

optSubpartitionDefElementList
    : subpartitionDefElement LPAREN,' subpartitionDefElement)?
    |
    ;

subpartitionDefElement
    : SUBPARTITION IDENTIFIER VALUES partitionBoundSpec
    ;

partitionBoundSpec
    : IN 'LPAREN exprList RPAREN'
    | 'LPAREN exprList RPAREN'
    ;

exprList
    : expr LPAREN,' expr)*
    ;

// ==================== DROP Statement ====================

dropstmt
    : DROP TABLE IDENTIFIER (IF EXISTS)?
    | DROP PROCEDURE (IF EXISTS)? IDENTIFIER (CASCADE | RESTRICT)?
    | DROP SCHEMA (IF EXISTS)? IDENTIFIER (CASCADE | RESTRICT)? (SEMI)?
    ;

// ==================== SET Statement ====================

setstmt
    : SET IDENTIFIER (TO | '=RPAREN aexpr (SEMI)?
    ;

// ==================== SCHEMA Statement ====================

createschemastmt
    : CREATE SCHEMA IDENTIFIER (SEMI)?
    ;

// ==================== EXPLAIN Statement ====================

explainstmt
    : EXPLAIN (LPAREN explainOption (COMMA explainOption)* RPAREN)? selectstmt (SEMI)?
    ;

explainOption
    : IDENTIFIER
    | BOOLEAN
    ;

// ==================== SHOW Statement ====================

showstmt
    : SHOW IDENTIFIER (SEMI)?
    ;

// ==================== Transaction Statements ====================

beginstmt
    : BEGIN (SEMI)?
    ;

commitstmt
    : COMMIT (SEMI)?
    ;

rollbackstmt
    : ROLLBACK (SEMI)?
    ;

// ==================== ANALYZE Statement ====================

analyzestmt
    : ANALYZE IDENTIFIER? (SEMI)?
    ;

// ==================== ALTER Statement ====================

alterstmt
    : ALTER TABLE IDENTIFIER altertablecmds
    | alterForeignTableStmt
    ;

altertablecmds
    : altertablecmd LPAREN,' altertablecmd)*
    ;

altertablecmd
    : ADD COLUMN columnDef
    | DROP COLUMN IDENTIFIER
    | ADD tableconstraint
    ;

// ==================== Expressions ====================

expr
    : aexpr
    ;

aexpr
    : cexpr
    | aexpr '+' aexpr
    | aexpr '-' aexpr
    | aexpr '*' aexpr
    | aexpr '/' aexpr
    | aexpr '=' aexpr
    | aexpr NOT_EQ aexpr
    | aexpr '<' aexpr
    | aexpr '>' aexpr
    | aexpr LTE_OP aexpr
    | aexpr GTE_OP aexpr
    | aexpr AND aexpr
    | aexpr OR aexpr
    | NOT aexpr
    | aexpr LIKE aexpr
    | aexpr NOT LIKE aexpr
    | aexpr IN inExpr
    | aexpr NOT IN inExpr
    | aexpr IS NULL_P
    | aexpr IS NOT NULL_P
    | aexpr IS TRUE_P
    | aexpr IS NOT TRUE_P
    | aexpr IS FALSE_P
    | aexpr IS NOT FALSE_P
    | aexpr BETWEEN aexpr AND aexpr
    | aexpr NOT BETWEEN aexpr AND aexpr
    | 'LPAREN aexpr RPAREN'
    ;

cexpr
    : qualifiedIdentifier
    | ICONST
    | FCONST
    | SCONST
    | TRUE_P
    | FALSE_P
    | NULL_P
    | ON
    | OFF
    | functionCall
    | 'LPAREN selectstmt RPAREN'
    | 'LPAREN aexpr RPAREN'
    ;

qualifiedIdentifier
    : IDENTIFIER LPAREN.' IDENTIFIER)*
    ;

functionCall
    : IDENTIFIER 'LPAREN RPAREN'
    | IDENTIFIER LPAREN aexpr RPAREN
    | IDENTIFIER LPAREN aexpr COMMA exprList RPAREN
    | COUNT LPAREN MULT_OP RPAREN
    | COUNT LPAREN aexpr RPAREN
    | AVG LPAREN aexpr RPAREN
    | SUM LPAREN aexpr RPAREN
    | MIN LPAREN aexpr RPAREN
    | MAX LPAREN aexpr RPAREN
    ;

inExpr
    : LPAREN selectstmt RPAREN
    | LPAREN exprList RPAREN
    ;

// ==================== Hints (OpenGauss) ====================

hintBlock
    : HINT_COMMENT
    ;

hintItem
    : NESTLOOP LPAREN tableHintList RPAREN
    | MERGEJOIN LPAREN tableHintList RPAREN
    | HASHJOIN LPAREN tableHintList RPAREN
    ;

tableHintList
    : IDENTIFIER (COMMA IDENTIFIER)*
    |
    ;

// ==================== Foreign Tables (OpenGauss) ====================

createForeignTableStmt
    : CREATE FOREIGN TABLE IDENTIFIER LPAREN optforeigntableelementlist RPAREN SERVER IDENTIFIER optcreateforeigntableoptions
    ;

optcreateforeigntableoptions
    : OPTIONS LPAREN createForeignTableOptionList RPAREN optServerOptions
    | SERVER OPTIONS LPAREN createForeignTableOptionList RPAREN optTableOptions
    |
    ;

optServerOptions
    : SERVER OPTIONS LPAREN createForeignTableOptionList RPAREN
    |
    ;

optTableOptions
    : OPTIONS LPAREN createForeignTableOptionList RPAREN
    |
    ;

createForeignTableOptionList
    : createForeignTableOption (COMMA createForeignTableOption)*
    ;

createForeignTableOption
    : SCONST EQ SCONST
    | SCONST SCONST
    ;

// ALTER FOREIGN TABLE statement
alterForeignTableStmt
    : ALTER FOREIGN TABLE IDENTIFIER alterforeigntablecmds
    ;

alterforeigntablecmds
    : alterforeigntablecmd (COMMA alterforeigntablecmd)*
    ;

alterforeigntablecmd
    : ADD COLUMN columnDef
    | DROP COLUMN IDENTIFIER
    | ALTER COLUMN IDENTIFIER altercolumnaction
    | SERVER IDENTIFIER
    | OPTIONS LPAREN alterForeignTableOptionList RPAREN
    | RENAME TO IDENTIFIER
    | SET SCHEMA IDENTIFIER
    ;

altercolumnaction
    : TYPE typename
    | SET TYPE typename
    | SET DEFAULT expr
    | DROP DEFAULT
    ;

alterForeignTableOptionList
    : alterForeignTableOption (COMMA alterForeignTableOption)*
    ;

alterForeignTableOption
    : SET SCONST EQ SCONST
    | SET SCONST SCONST
    | DROP SCONST
    ;

// Foreign table column definitions with options
optforeigntableelementlist
    : foreigntableelementlist
    |
    ;

foreigntableelementlist
    : foreigntableelement (COMMA foreigntableelement)*
    ;

foreigntableelement
    : foreigncolumnDef
    | tableconstraint
    ;

foreigncolumnDef
    : IDENTIFIER typename foreigncolquallist?
    ;

foreigncolquallist
    : foreigncolqual*
    ;

foreigncolqual
    : colconstraint
    | OPTIONS LPAREN foreignColumnOptionList RPAREN
    ;

foreignColumnOptionList
    : foreignColumnOption (COMMA foreignColumnOption)*
    ;

foreignColumnOption
    : SCONST EQ SCONST
    | SCONST SCONST
    ;

// ==================== Lexer Rules ====================

// Keywords
IF: I F;
EXISTS: E X I S T S;
CASCADE: C A S C A D E;
RESTRICT: R E S T R I C T;
SELECT: S E L E C T;
FROM: F R O M;
WHERE: W H E R E;
GROUP: G R O U P;
BY: B Y;
HAVING: H A V I N G;
ORDER: O R D E R;
ASC: A S C;
DESC: D E S C;
NULLS: N U L L S;
FIRST: F I R S T;
LAST: L A S T;
LIMIT: L I M I T;
OFFSET: O F F S E T;
INSERT: I N S E R T;
INTO: I N T O;
VALUES: V A L U E S;
DEFAULT: D E F A U L T;
UPDATE: U P D A T E;
SET: S E T;
DELETE: D E L E T E;
CREATE: C R E A T E;
TABLE: T A B L E;
PROCEDURE: P R O C E D U R E;
REPLACE: R E P L A C E;
OUT: O U T;
INOUT: I N O U T;
LANGUAGE: L A N G U A G E;
SECURITY: S E C U R I T Y;
INVOKER: I N V O K E R;
DEFINER: D E F I N E R;
CONSTRAINT: C O N S T R A I N T;
NOT: N O T;
NULL_P: N U L L;
CHECK: C H E C K;
PRIMARY: P R I M A R Y;
KEY: K E Y;
 UNIQUE: U N I Q U E;
 PARTITION: P A R T I T I O N;
 RANGE: R A N G E;
 LIST: L I S T;
HASH: H A S H;
 PARTITIONS: P A R T I T I O N S;
 SUBPARTITION: S U B P A R T I T I O N;
 SUBPARTITIONS: S U B P A R T I T I O N S;
DROP: D R O P;
ALTER: A L T E R;
ADD: A D D;
COLUMN: C O L U M N;
FOREIGN: F O R E I G N;
SERVER: S E R V E R;
OPTIONS: O P T I O N S;
DISTINCT: D I S T I N C T;
ALL: A L L;
AS: A S;
BETWEEN: B E T W E E N;
IN: I N;
LIKE: L I K E;
TRUE_P: T R U E;
FALSE_P: F A L S E;
IS: I S;
AND: A N D;
WITH: W I T H;
RECURSIVE: R E C U R S I V E;
OR: O R;
BEGIN: B E G I N;
END: E N D;
NESTLOOP: N E S T L O O P;
MERGEJOIN: M E R G E J O I N;
HASHJOIN: H A S H J O I N;
OWNER: O W N E R;
RENAME: R E N A M E;
TO: T O;
SCHEMA: S C H E M A;
TYPE: T Y P E;
JOIN: J O I N;
INNER: I N N E R;
LEFT: L E F T;
RIGHT: R I G H T;
FULL: F U L L;
OUTER: O U T E R;
CROSS: C R O S S;
ON: O N;
OFF: O F F;
DUPLICATE: D U P L I C A T E;
NOTHING: N O T H I N G;
USING: U S I N G;
COUNT: C O U N T;
AVG: A V G;
SUM: S U M;
MIN: M I N;
MAX: M A X;
CALL: C A L L;
ARROW: '=' '>';
EXPLAIN: E X P L A I N;
SHOW: S H O W;
BEGIN: B E G I N;
COMMIT: C O M M I T;
ROLLBACK: R O L L B A C K;
ANALYZE: A N A L Y Z E;

// Operators
NOT_EQ: '!=' | '<>';
LTE_OP: '<=';
GTE_OP: '>=';
PLUS_OP: '+';
MINUS_OP: '-';
MULT_OP: '*';
DIV_OP: '/';
EQ: '=';

// Parentheses
LPAREN: 'LPAREN;
RPAREN: RPAREN';

// Comma
COMMA: ',';

// Semicolon
SEMI: ';';

// Identifiers and Literals
IDENTIFIER
    : [a-zA-Z_][a-zA-Z0-9_]*
    ;

ICONST
    : [0-9]+
    ;

FCONST
    : [0-9]+ '.' [0-9]* | '.' [0-9]+
    ;

SCONST
    : '\'' (~'\'' | '\'\'RPAREN* '\''
    ;

// Comments and Whitespace
LINE_COMMENT
    : '--' ~[\r\n]* -> skip
    ;

// Hint comments - parse as tokens for hint processing
HINT_COMMENT
    : '/*+' .*? '*/'
    ;

// Regular block comments
BLOCK_COMMENT
    : '/*' ~[+] .*? '*/' -> skip
    ;

WS
    : [ \t\r\n]+ -> skip
    ;

// Case-insensitive letter fragments
fragment A: [aA];
fragment B: [bB];
fragment C: [cC];
fragment D: [dD];
fragment E: [eE];
fragment F: [fF];
fragment G: [gG];
fragment H: [hH];
fragment I: [iI];
fragment J: [jJ];
fragment K: [kK];
fragment L: [lL];
fragment M: [mM];
fragment N: [nN];
fragment O: [oO];
fragment P: [pP];
fragment Q: [qQ];
fragment R: [rR];
fragment S: [sS];
fragment T: [tT];
fragment U: [uU];
fragment V: [vV];
fragment W: [wW];
fragment X: [xX];
fragment Y: [yY];
fragment Z: [zZ];
